APP_ENV=development
PORT=8080
APP_PATH_PREFIX=/tasteroute/api

DATABASE_URL=postgres://tasteroute:tasteroute@localhost:5432/tasteroute?sslmode=disable
REDIS_URL=redis://localhost:6379/0

GUEST_JWT_SECRET=replace-with-a-random-string-at-least-16-chars
RESTAURANT_JWT_SECRET=replace-with-another-random-string-at-least-16-chars
ADMIN_TOKEN=replace-with-a-long-admin-token

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Публичный origin для ссылок-приглашений. Пусто — использовать текущий адрес браузера.
PUBLIC_APP_URL=

# Публичный туннель: serveo, ngrok или cloudflare.
TUNNEL_PROVIDER=serveo
SERVEO_SUBDOMAIN=
SERVEO_SSH_PORT=443
SERVEO_SSH_KEY=
NGROK_DOMAIN=
